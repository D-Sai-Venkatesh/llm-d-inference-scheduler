# exp-ops/configs/core-q8.env — GSCH-CORE, Q=8. Identical to core-q4.env except the
# ONE value: Q8 is the same code with the number 8 (no mode, no ceiling).
# DIGEST: groupsched-88e74f85 — THE MP WAVE'S BUILD, and this file stays on it. A newer
# build exists (groupsched-8397e9aa: the F5' module + two observability fixes, decision-
# identical at entryOrder=newcomer-first) and it is used ONLY by the B5/B6 pair, which
# carries its own same-digest Q4 anchor (core-q4-8397e9aa.env). Do not re-pin this file:
# the wave is defined on 88e74f85 and B1 already ran there, and a mid-wave build switch
# muddies provenance even when the decisions are provably identical.
EPP_IMAGE_TAG=groupsched-88e74f85
EPP_IMAGE_DIGEST=sha256:16b02e17ed3e2d9022e9a37f94245e3783b538a776223855ba4b4b9287f20925
EPP_IMAGE_DIGEST_AMD64=sha256:2f62059465efc17efe546890a3ed5576c75e523a33bc7c85858bf85496d88de2
REQUIRE_BUILD_PIN=1
CHAIN=groupsched-core
PROTOCOL_CELL=weka-c128
CONCURRENCY=128

GROUP_BUDGET_FRACTION=0.95
CORE_QUANTUM=8
IDLE_SECONDS=20
TTL_SECONDS=30
COLD_ENTRY_CAP_TOKENS=131072
INFLIGHT_CAP=64
BLOCK_SIZE_TOKENS=64
CAPACITY_LIVENESS_SECONDS=120
INFLIGHT_REAP_SECONDS=3700

CORE_SIZING=index
CORE_ENTRY_ORDER=newcomer-first
CORE_ENGINE_CHOICE=most-free-budget
CORE_ROTATION=quantum
CORE_VICTIM=valve
CORE_SAFETY=none

BRANCH_PLUGIN=1
# YAML bool, VERBATIM into the plugin block: logRequests is a Go bool and the decode
# is strict, so `1` renders `logRequests: 1` (a number) and CrashLoops every arm.
BRANCH_LOG_REQUESTS=true
AFFINITY_FILTER=0
CORE_DETECTOR=group
BENCH_IMAGE=quay.io/dasari_surya_sai_venkatesh1/llm-d-benchmark:aiperf-rootid
