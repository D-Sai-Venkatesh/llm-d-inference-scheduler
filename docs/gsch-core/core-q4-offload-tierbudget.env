# exp-ops/configs/core-q4-offload-tierbudget.env — GSCH-CORE, Q=4, CPU OFFLOAD ON, DEFAULT
# queue (newcomer-first), the TIER-SIZED seat budget (`sizing: gpu-plus-tier`).
# PREREG-multipod-offload.
#
# THIS FILE IS core-q4-offload.env WITH ONE SETTING CHANGED — the sizing selector. The two
# are therefore a same-build, same-digest, same-deployment pair, and any difference between
# the arms IS the seat budget:
#
#     diff docs/gsch-core/core-q4-offload.env docs/gsch-core/core-q4-offload-tierbudget.env
#
# The rule: the seat budget is a fraction of the engine's WHOLE reachable working set —
#
#     budgetBlocks = floor(groupBudgetFraction x (num_gpu_blocks + tierBlocks))
#
# where tierBlocks is the CPU tier shadow's capacity, the SAME two deployment facts that
# already size the shadow (cpuTierBytes / kvBlockBytes, 87,381 blocks on this deployment).
# On a 40,183-block engine that is floor(0.95 x (40183 + 87381)) = 121,186 blocks instead of
# 38,173 — the budget now covers the GPU pool plus the tier behind it (3.17x), which is the
# capacity a seated member's chain can come back from for ~1-4 % of a prefill.
#
# WHY THE DEFAULT QUEUE. This arm isolates ONE question: does the GPU-only budget leave
# throughput on the table when a miss is a restore instead of a prefill? The queue module
# stays the arm's default, so the comparison against core-q4-offload.env is the budget and
# nothing else. The frozen motivation: at c64, stock FCFS gained ~2x from offload
# (FCFS-ON 1.390 req/s) where the GPU-sized core gained 1.267, because the core's budget
# counts HBM only exactly when a miss is expensive.
#
# WHAT DOES NOT MOVE. The per-head cost stays the GPU-only one (admission prices what a
# head will occupy in HBM) and the cold-entry valve's cap stays the GPU headroom,
# floor((1 - 0.95) x 40,183) blocks x 64 tokens = 128,576 tokens: the valve staggers GPU
# allocation bursts, and the tier cannot absorb one. Both are pinned by test
# (TestGpuPlusTierCostIsTheGPUOnlyCost, TestGpuPlusTierValveCapStaysGPUHeadroom).
#
# tier = 0 makes this arm arithmetically identical to `sizing: "index"`
# (TestGpuPlusTierZeroTierEqualsGPU), so an OFF cell of this arm is not a second policy.
#
# THE IMAGE PIN IS A PLACEHOLDER: no build carries `sizing: gpu-plus-tier` yet, so this arm
# must not name a digest. Pin EPP_IMAGE_TAG/EPP_IMAGE_DIGEST* to the review build before the
# cell is deployed, and never re-point core-q4-offload.env (the pair is ONE digest).

EPP_IMAGE_TAG=PLACEHOLDER-tierbudget-build
EPP_IMAGE_DIGEST=
EPP_IMAGE_DIGEST_AMD64=
REQUIRE_BUILD_PIN=1
CHAIN=groupsched-core
PROTOCOL_CELL=weka-c128
CONCURRENCY=128

# ---- the engine's CPU KV tier (the offload deployment) ----
OFFLOAD=1
DECODE_TIER_BYTES=549755813888

# ---- the core's parameters (base block: the same for every core arm) ----
GROUP_BUDGET_FRACTION=0.95
CORE_QUANTUM=4
IDLE_SECONDS=20
TTL_SECONDS=30
INFLIGHT_CAP=64
BLOCK_SIZE_TOKENS=64
CAPACITY_LIVENESS_SECONDS=120
INFLIGHT_REAP_SECONDS=3700
# the tier shadow's two facts (see core-hrrn-tier-q4.env's header for the arithmetic).
# They size the shadow AND, at this arm's sizing value, the budget it is added to.
CPU_TIER_BYTES=549755813888
KV_BLOCK_BYTES=6291456

# ---- the module selectors (one value each; ONE differs from core-q4-offload.env) ----
CORE_SIZING=gpu-plus-tier
CORE_ENTRY_ORDER=newcomer-first
CORE_ENGINE_CHOICE=most-free-budget
CORE_ROTATION=quantum
CORE_VICTIM=valve
CORE_SAFETY=none

# ---- the chain (see the audit) ----
BRANCH_PLUGIN=1
BRANCH_LOG_REQUESTS=true
AFFINITY_FILTER=0
CORE_DETECTOR=group
BENCH_IMAGE=quay.io/dasari_surya_sai_venkatesh1/llm-d-benchmark:aiperf-rootid
