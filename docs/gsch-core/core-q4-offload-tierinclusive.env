# exp-ops/configs/core-q4-offload-tierinclusive.env — GSCH-CORE, Q=4, CPU OFFLOAD ON,
# DEFAULT queue (newcomer-first), the TIER-INCLUSIVE seat budget (`sizing: tier-inclusive`).
# PREREG-multipod-offload.
#
# THIS FILE IS core-q4-offload.env WITH ONE SETTING CHANGED — the sizing selector. The two
# are therefore a same-build, same-digest, same-deployment pair, and any difference between
# the arms IS the seat budget:
#
#     diff docs/gsch-core/core-q4-offload.env docs/gsch-core/core-q4-offload-tierinclusive.env
#
# The rule: the seat budget is a fraction of the engine's UNIQUE KV capacity —
#
#     budgetBlocks = floor(groupBudgetFraction x max(num_gpu_blocks, tierBlocks))
#
# where tierBlocks is the CPU tier shadow's capacity, the SAME two deployment facts that
# already size the shadow (cpuTierBytes / kvBlockBytes = 87,381 blocks on this deployment,
# 2.17x the 40,183-block GPU pool).
#
# WHY THE MAX AND NOT THE SUM. vLLM's native CPU offload is WRITE-THROUGH at compute time:
# every chunk is stored to the tier as it is computed, and nothing is stored on GPU
# eviction. The tier therefore holds a copy of essentially everything HBM holds, and a block
# that is on the GPU is (by construction) also in the tier. The hierarchy is INCLUSIVE: what
# an engine can reach is the MAX of the two capacities, because a block needs a place in ONE
# of them. On this deployment the tier is the larger, so it IS the unique capacity:
#
#     budget = floor(0.95 x 87,381) = 83,011 blocks   (2.17x the GPU-only 38,173)
#
# The ADDITIVE rule this replaces (fraction x 40,183 + 87,381 = 121,185 blocks, 3.02x the
# GPU) counted ~46 % blocks that live in both places at once, and that over-seating is part
# of what batch 2 measured downstream (see the header of core-q4-offload-tierinclusive-
# execbudget.env). The additive value was `sizing: "gpu-plus-tier"`, it is RETIRED from the
# build, and this file used to be core-q4-offload-tierbudget.env: batch 2's arm and its
# measurement are archived in docs/gsch-core/README.md §4f at commit 17a10e8c / digest
# groupsched-17a10e8c.
#
# WHY THE DEFAULT QUEUE. This arm isolates ONE question: does the GPU-only budget leave
# throughput on the table when a miss is a restore instead of a prefill? The queue module
# stays the arm's default, so the comparison against core-q4-offload.env is the budget and
# nothing else. The frozen motivation: at c64, stock FCFS gained ~2x from offload
# (FCFS-ON 1.390 req/s) where the GPU-sized core gained 1.267, because the core's budget
# counts HBM only exactly when a miss is expensive.
#
# WHAT DOES NOT MOVE. The per-head cost stays the GPU-only one (admission prices what a
# head will occupy in HBM) and the cold-entry valve's cap stays the GPU headroom,
# floor((1 - 0.95) x 40,183) blocks x 64 tokens = 128,576 tokens: the valve staggers GPU
# allocation bursts, and the tier cannot absorb one. Both are pinned by test
# (TestTierInclusiveCostIsTheGPUOnlyCost, TestTierInclusiveValveCapStaysGPUHeadroom).
#
# tier = 0 makes this arm arithmetically identical to `sizing: "index"`
# (TestTierInclusiveZeroTierEqualsGPU), so an OFF cell of this arm is not a second policy.
#
# THE IMAGE PIN IS A PLACEHOLDER: no build carries `sizing: tier-inclusive` yet, so this arm
# must not name a digest. Pin EPP_IMAGE_TAG/EPP_IMAGE_DIGEST* to the review build before the
# cell is deployed, and never re-point core-q4-offload.env (the pair is ONE digest).

EPP_IMAGE_TAG=PLACEHOLDER-tierinclusive-build
EPP_IMAGE_DIGEST=
EPP_IMAGE_DIGEST_AMD64=
REQUIRE_BUILD_PIN=1
CHAIN=groupsched-core
PROTOCOL_CELL=weka-c128
CONCURRENCY=128

# ---- the engine's CPU KV tier (the offload deployment) ----
OFFLOAD=1
DECODE_TIER_BYTES=549755813888

# ---- the core's parameters (base block: the same for every core arm) ----
GROUP_BUDGET_FRACTION=0.95
CORE_QUANTUM=4
IDLE_SECONDS=20
TTL_SECONDS=30
INFLIGHT_CAP=64
BLOCK_SIZE_TOKENS=64
CAPACITY_LIVENESS_SECONDS=120
INFLIGHT_REAP_SECONDS=3700
# the tier shadow's two facts (see core-hrrn-tier-q4.env's header for the arithmetic).
# They size the shadow AND, at this arm's sizing value, the capacity the budget is a
# fraction of.
CPU_TIER_BYTES=549755813888
KV_BLOCK_BYTES=6291456

# ---- the module selectors (one value each; ONE differs from core-q4-offload.env) ----
CORE_SIZING=tier-inclusive
CORE_ENTRY_ORDER=newcomer-first
CORE_ENGINE_CHOICE=most-free-budget
CORE_ROTATION=quantum
CORE_VICTIM=valve
CORE_SAFETY=none

# ---- the chain (see the audit) ----
BRANCH_PLUGIN=1
BRANCH_LOG_REQUESTS=true
AFFINITY_FILTER=0
CORE_DETECTOR=group
BENCH_IMAGE=quay.io/dasari_surya_sai_venkatesh1/llm-d-benchmark:aiperf-rootid
