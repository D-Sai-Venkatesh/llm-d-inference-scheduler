# exp-ops/configs/core-q8.env — GSCH-CORE, Q=8. Identical to core-q4.env except the
# ONE value: Q8 is the same code with the number 8 (no mode, no ceiling).
EPP_IMAGE_TAG=groupsched-core-<SHA>
REQUIRE_BUILD_PIN=1
CHAIN=groupsched-core
PROTOCOL_CELL=weka-c128
CONCURRENCY=128

GROUP_BUDGET_FRACTION=0.95
CORE_QUANTUM=8
IDLE_SECONDS=20
TTL_SECONDS=30
COLD_ENTRY_CAP_TOKENS=131072
INFLIGHT_CAP=64
BLOCK_SIZE_TOKENS=64
CAPACITY_LIVENESS_SECONDS=120
INFLIGHT_REAP_SECONDS=3700

CORE_SIZING=index
CORE_ENTRY_ORDER=newcomer-first
CORE_ENGINE_CHOICE=most-free-budget
CORE_ROTATION=quantum
CORE_VICTIM=valve
CORE_SAFETY=none

BRANCH_PLUGIN=1
BRANCH_LOG_REQUESTS=1
AFFINITY_FILTER=0
CORE_DETECTOR=group
BENCH_IMAGE=quay.io/dasari_surya_sai_venkatesh1/llm-d-benchmark:aiperf-rootid
