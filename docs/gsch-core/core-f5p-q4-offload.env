# exp-ops/configs/core-f5p-q4-offload.env — GSCH-CORE, Q=4, CPU OFFLOAD ON, the TIER-BLIND
# queue module (`entryOrder: hrrn-bounded`, F5′). PREREG-multipod-offload.
#
# THIS FILE IS core-hrrn-tier-q4.env WITH ONE SETTING CHANGED — the entry order. Read that
# file's header for the tier facts, the shadow-validation gates and the emitter
# precondition; everything there applies here verbatim EXCEPT that this arm does NOT read
# the tier shadow at all:
#
#     diff docs/gsch-core/core-hrrn-tier-q4.env docs/gsch-core/core-f5p-q4-offload.env
#
# WHY THIS ARM EXISTS (and why it must carry the same tier facts): it is the comparator the
# offload-solution claim is stated against, so it must be the SAME build, the SAME
# deployment and the SAME parameters — a same-digest pair one selector apart. Its
# `cpuTierBytes`/`kvBlockBytes` are set so the two arms' rendered configs differ in exactly
# one line; the values only size a shadow this arm never prices with (the shadow-validation
# series still collect here, which is how the AUC gets a tier-blind baseline for free).
#
# Use core-q4-offload.env, not this file, for the ACCOUNTING fix's live confirmation: that
# arm is the default (newcomer-first) queue on the same build and the same offload
# deployment.

EPP_IMAGE_TAG=groupsched-99a47617
EPP_IMAGE_DIGEST=sha256:1163763c0afbe97e116bbe29d71a830105c4c73c16f7811304920d769aac3c4b
EPP_IMAGE_DIGEST_AMD64=sha256:6207d362256d1708cc7f97673fb81d1c83f0449dea4023d3508eac62844522ca
REQUIRE_BUILD_PIN=1
CHAIN=groupsched-core
PROTOCOL_CELL=weka-c128
CONCURRENCY=128

# ---- the engine's CPU KV tier (the offload deployment) ----
OFFLOAD=1
DECODE_TIER_BYTES=549755813888

# ---- the core's parameters (base block: the same for every core arm) ----
GROUP_BUDGET_FRACTION=0.95
CORE_QUANTUM=4
IDLE_SECONDS=20
TTL_SECONDS=30
INFLIGHT_CAP=64
BLOCK_SIZE_TOKENS=64
CAPACITY_LIVENESS_SECONDS=120
INFLIGHT_REAP_SECONDS=3700
# the tier shadow's two facts (the same as core-hrrn-tier-q4.env)
CPU_TIER_BYTES=549755813888
KV_BLOCK_BYTES=6291456

# ---- the module selectors (one value each; ONE differs from core-hrrn-tier-q4.env) ----
CORE_SIZING=index
CORE_ENTRY_ORDER=hrrn-bounded
CORE_ENGINE_CHOICE=most-free-budget
CORE_ROTATION=quantum
CORE_VICTIM=valve
CORE_SAFETY=none

# ---- the chain (see the audit) ----
BRANCH_PLUGIN=1
BRANCH_LOG_REQUESTS=true
AFFINITY_FILTER=0
CORE_DETECTOR=group
BENCH_IMAGE=quay.io/dasari_surya_sai_venkatesh1/llm-d-benchmark:aiperf-rootid
