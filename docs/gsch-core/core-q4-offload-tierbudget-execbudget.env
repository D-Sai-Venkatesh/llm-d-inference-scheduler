# exp-ops/configs/core-q4-offload-tierbudget-execbudget.env — GSCH-CORE, Q=4, CPU OFFLOAD
# ON, DEFAULT queue (newcomer-first), the TIER-SIZED seat budget (`sizing: gpu-plus-tier`)
# AND the EXECUTION BUDGET (`executionBudget: execution-budget`).
# PREREG-multipod-offload, "BATCH 2 (tierbudget c64) + THE EXECUTION BUDGET".
#
# THIS FILE IS core-q4-offload-tierbudget.env WITH ONE SETTING CHANGED — the dispatch
# selector. The two are a same-build, same-digest, same-deployment pair, so any difference
# between the arms IS the execution budget:
#
#     diff docs/gsch-core/core-q4-offload-tierbudget.env \
#          docs/gsch-core/core-q4-offload-tierbudget-execbudget.env
#
# THE PROBLEM IT FIXES (measured, batch 2 at c64: tierbudget vs same-digest q4-offload):
# the tier-sized budget widened the WORKING SET (GPU + CPU tier = 3.17x the GPU pool) and
# then let that many members be SEATED — and seated members RUN. A running request's KV
# needs HBM blocks, so the tier does not widen execution: with 121,186 blocks of seats on a
# 40,183-block GPU, vLLM queued and preempted what the EPP had just dispatched. Measured:
# 43 preemptions vs 0, TTFT p50 0.9 s -> 17.8 s, newcomer TTFT p90 9.9 s -> 142 s, while
# throughput did improve (X +10.8 %, level with FCFS-ON) — the recompute waste is the
# preemption.
#
# THE FIX = TWO BUDGETS, both from deployment facts, no constant:
#
#     SEATING  (residency) = fraction x (num_gpu_blocks + tierBlocks)   [unchanged, §4f]
#     DISPATCH (execution) = fraction x  num_gpu_blocks                 [this arm]
#
# The dispatch budget is tested against the engine's RUNNING SET: the dedup-exact union of
# its in-flight requests' chain blocks, from the EPP's OWN accounting (the BlockIndex
# refcount of the dispatched requests — not an endpoint metric, so the deleted per-engine
# gate's latch class cannot come back). A turn that would not fit waits in the EPP's
# ordered queue (FIFO by turn arrival among the dispatch-eligible) instead of being
# dispatched into vLLM's preempting one. LIVENESS: one turn is always allowed when nothing
# is in flight on the engine.
#
# WHAT DOES NOT MOVE: the seat budget, the per-head cost, the cold-entry valve's cap, the
# queue order, placement, rotation. The default value is "none", and every other arm is
# byte-identical with and without this module (`TestExecutionBudgetDefaultIsGoldenNeutral`,
# `TestExecutionBudgetNoEffectWhenTheRunningSetFits`).
#
# THE IMAGE PIN IS SET (README §4a5, the ONE digest from here): both sides of the pair —
# core-q4-offload-tierbudget.env and this file — must be pinned to the SAME digest before
# the cells run, and never re-pointed afterwards.

EPP_IMAGE_TAG=groupsched-17a10e8c
EPP_IMAGE_DIGEST=sha256:f71edae25dca386ce5ea499bede3d435274e6b7f323fd56d06a3e4665b92db92
EPP_IMAGE_DIGEST_AMD64=sha256:303d16eb313379a006315a4d277c98e10efb967f44730bb7e285b2230a8f48c6
REQUIRE_BUILD_PIN=1
CHAIN=groupsched-core
PROTOCOL_CELL=weka-c64
CONCURRENCY=64

# ---- the engine's CPU KV tier (the offload deployment) ----
OFFLOAD=1
DECODE_TIER_BYTES=549755813888

# ---- the core's parameters (base block: the same for every core arm) ----
GROUP_BUDGET_FRACTION=0.95
CORE_QUANTUM=4
IDLE_SECONDS=20
TTL_SECONDS=30
INFLIGHT_CAP=64
BLOCK_SIZE_TOKENS=64
CAPACITY_LIVENESS_SECONDS=120
INFLIGHT_REAP_SECONDS=3700
CPU_TIER_BYTES=549755813888
KV_BLOCK_BYTES=6291456

# ---- the module selectors (one value each; ONE differs from core-q4-offload-tierbudget.env) ----
CORE_SIZING=gpu-plus-tier
CORE_ENTRY_ORDER=newcomer-first
CORE_ENGINE_CHOICE=most-free-budget
CORE_ROTATION=quantum
CORE_VICTIM=valve
CORE_SAFETY=none
CORE_EXECUTION_BUDGET=execution-budget

# ---- the chain (see the audit) ----
BRANCH_PLUGIN=1
BRANCH_LOG_REQUESTS=true
AFFINITY_FILTER=0
CORE_DETECTOR=group
BENCH_IMAGE=quay.io/dasari_surya_sai_venkatesh1/llm-d-benchmark:aiperf-rootid
