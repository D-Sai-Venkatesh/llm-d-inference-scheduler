# exp-ops/configs/core-f5p-q4.env — GSCH-CORE, Q=4, entryOrder=hrrn-bounded (F5′).
#
# THIS FILE IS core-q4-8397e9aa.env WITH ONE SETTING CHANGED — the entry order. The
# settings-wise diff of the two is that single line, so the B5/B6 pair
# (core-Q4 ‖ core-F5′-Q4) is a same-build, same-digest, one-selector comparison and any
# difference between the arms IS the entry order:
#
#     diff docs/gsch-core/core-q4-8397e9aa.env docs/gsch-core/core-f5p-q4.env
#
# The rule (docs/gsch-core/README.md §4d): priority = wait ÷ min(this waiter's cold
# tokens, the LOWER-median cold tokens of the current waiters), each size floored at one
# block, the median recomputed per head choice. The newcomer class stays the OUTER key
# (the archive's semantics): F5′ does NOT let a returning main thread catch up with
# newcomers — it lets SMALL BRANCHES PASS BIG ONES WITHIN A CLASS. Read the per-class
# tables, not the aggregate.
#
# Equivalence with the archive's dd5350b5 F5′ is a test, not a claim:
# TestHrrnBoundedEqualsTheArchiveF5P (byte for byte, no normalisation;
# docs/gsch-core/golden-f5p-recipe.md).
#
# The core is per-engine ONLY (no ENGINE_GROUPS knob), pins placement with its OWN
# Filter (no session-affinity-filter), and answers the flow-control gate with its OWN
# detector (no utilization-detector). See docs/gsch-core/README.md for the full chain
# audit — the plugin list below is the SHORT one on purpose.

EPP_IMAGE_TAG=groupsched-8397e9aa
EPP_IMAGE_DIGEST=sha256:6aff12ac8608506d2f53740bda705d0b753f2993991023324466d4179100c846
EPP_IMAGE_DIGEST_AMD64=sha256:aa0a911d3670337822b55e5c1ed67696cd159bf28cb51c3d5001d697dc904a1c
REQUIRE_BUILD_PIN=1
CHAIN=groupsched-core
PROTOCOL_CELL=weka-c128
CONCURRENCY=128

# ---- the core's parameters (base block: the same for every core arm) ----
GROUP_BUDGET_FRACTION=0.95
CORE_QUANTUM=4
IDLE_SECONDS=20
TTL_SECONDS=30
COLD_ENTRY_CAP_TOKENS=131072
INFLIGHT_CAP=64
BLOCK_SIZE_TOKENS=64
CAPACITY_LIVENESS_SECONDS=120
INFLIGHT_REAP_SECONDS=3700

# ---- the module selectors (one value each; the defaults, written out) ----
CORE_SIZING=index
CORE_ENTRY_ORDER=hrrn-bounded
CORE_ENGINE_CHOICE=most-free-budget
CORE_ROTATION=quantum
CORE_VICTIM=valve
# "none" = the seat budget IS the admission control (the human's model).
# "budget-fraction" = the memory-only backstop (off; evidence in the README §5).
CORE_SAFETY=none

# ---- the chain (see the audit) ----
# no AGENT_IDENTITY: the member is the derived branch, nothing else is needed
BRANCH_PLUGIN=1
# YAML bool, VERBATIM into the plugin block: logRequests is a Go bool and the decode
# is strict, so `1` renders `logRequests: 1` (a number) and CrashLoops every arm.
BRANCH_LOG_REQUESTS=true
# no AFFINITY_FILTER: the group scheduler's own Filter pins dispatch to the seat
AFFINITY_FILTER=0
# no utilization-detector: the group scheduler IS the saturationDetector
CORE_DETECTOR=group
BENCH_IMAGE=quay.io/dasari_surya_sai_venkatesh1/llm-d-benchmark:aiperf-rootid
