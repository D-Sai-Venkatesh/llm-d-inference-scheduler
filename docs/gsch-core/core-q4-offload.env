# exp-ops/configs/core-q4-offload.env — GSCH-CORE, Q=4, CPU OFFLOAD ON, the DEFAULT queue
# (newcomer-first). PREREG-multipod-offload.
#
# THIS FILE IS core-q4.env WITH THE OFFLOAD DEPLOYMENT ADDED — the tier facts in the
# parameters block and OFFLOAD=1 on the engines — and NOTHING ELSE. It is the same-digest
# ON partner of core-q4.env's OFF cell, so the OFF/ON pair differs in the deployment, not
# in the policy:
#
#     diff docs/gsch-core/core-q4.env docs/gsch-core/core-q4-offload.env
#
# TWO JOBS, both pre-registered:
#   1. THE ACCOUNTING FIX'S LIVE CONFIRMATION — the fixed core with offload OFF vs ON
#      (preemptions vs FCFS, the invariant "reconstructed pinned set <= pool at p90").
#   2. The offload solution's ANCHOR — the tier-aware queue arm (core-hrrn-tier-q4.env) is
#      scored as ">= +30 pts restored share on returns away 1-10 min" against THIS arm at
#      the same c128 load, and this arm is also what "stock offload gain" means.
#
# The shadow is configured but unread here (entryOrder stays newcomer-first), so the
# shadow-validation series collect a TIER-BLIND baseline: same deployment, no tier-aware
# ordering. If those pairs already rank well, the model is right and any hrrn-tier gain is
# the ORDER, not the shadow.

# DIGEST: groupsched-e78152da (README §4a6) — the TIER-INCLUSIVE build. This file is the
# INDEX arm of the c64 triple (index ‖ tier-inclusive ‖ tier-inclusive + execution budget)
# and the offload program's anchor, so it must run the SAME build as the other two: its
# batch-2 pin (groupsched-99a47617) is OVERWRITTEN here, in one operation with them. The
# re-pin does not move this arm's decisions — its selector is `sizing: "index"`, the default
# replay is byte-identical (§4a6), and the tier-inclusive correction only changes arms whose
# CORE_SIZING is "tier-inclusive".
EPP_IMAGE_TAG=groupsched-e78152da
EPP_IMAGE_DIGEST=sha256:4c44cf26d51017a49fae1376f3bc24fad4db268c9d51d5cc7e419cb81c27f639
EPP_IMAGE_DIGEST_AMD64=sha256:8362525787f987f3ebd5b3927953c4751b319f2c4571daa7a4a697eecafbdc5a
REQUIRE_BUILD_PIN=1
CHAIN=groupsched-core
PROTOCOL_CELL=weka-c128
CONCURRENCY=128

# ---- the engine's CPU KV tier (the offload deployment) ----
OFFLOAD=1
DECODE_TIER_BYTES=549755813888

# ---- the core's parameters (base block: the same for every core arm) ----
GROUP_BUDGET_FRACTION=0.95
CORE_QUANTUM=4
IDLE_SECONDS=20
TTL_SECONDS=30
INFLIGHT_CAP=64
BLOCK_SIZE_TOKENS=64
CAPACITY_LIVENESS_SECONDS=120
INFLIGHT_REAP_SECONDS=3700
# the tier shadow's two facts (see core-hrrn-tier-q4.env's header for the arithmetic)
CPU_TIER_BYTES=549755813888
KV_BLOCK_BYTES=6291456

# ---- the module selectors (one value each; the defaults, written out) ----
CORE_SIZING=index
CORE_ENTRY_ORDER=newcomer-first
CORE_ENGINE_CHOICE=most-free-budget
CORE_ROTATION=quantum
CORE_VICTIM=valve
CORE_SAFETY=none

# ---- the chain (see the audit) ----
BRANCH_PLUGIN=1
BRANCH_LOG_REQUESTS=true
AFFINITY_FILTER=0
CORE_DETECTOR=group
BENCH_IMAGE=quay.io/dasari_surya_sai_venkatesh1/llm-d-benchmark:aiperf-rootid
