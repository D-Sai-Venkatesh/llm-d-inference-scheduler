# exp-ops/configs/core-q4-anchor-n1.env — the MATCHED ANCHOR: core-Q4 at N=1, c128,
# 45 min. Its comparison is B2a f0p's FIRST 45 minutes; the difference IS the wave's
# engine effect on single-pod (the gate removal + the refactor), which is exactly what
# the golden cannot measure (the simulator has no engine).
#
# Run it with an ordinary single-pod deploy (ENGINES=1); everything else is core-q4.env.
# DIGEST HISTORY: 88e74f85 (the 2-pod wave's build) -> 8397e9aa (this one: F5' + the
# two observability fixes). Everything added since 88e74f85 is inert at
# entryOrder=newcomer-first — the hrrn-bounded module is only read when it is selected,
# and the valve-held attribution and the C8 gauge/counter touch no decision. Evidence:
# testdata/golden-f0p-bugfixes.txt is reproduced byte for byte at BOTH commits, so a
# core-Q4 arm measures the same decisions on either build. Any arm already run keeps
# its own recorded pin.
EPP_IMAGE_TAG=groupsched-8397e9aa
EPP_IMAGE_DIGEST=sha256:6aff12ac8608506d2f53740bda705d0b753f2993991023324466d4179100c846
EPP_IMAGE_DIGEST_AMD64=sha256:aa0a911d3670337822b55e5c1ed67696cd159bf28cb51c3d5001d697dc904a1c
REQUIRE_BUILD_PIN=1
CHAIN=groupsched-core
PROTOCOL_CELL=weka-c128
CONCURRENCY=128
ENGINES=1

GROUP_BUDGET_FRACTION=0.95
CORE_QUANTUM=4
IDLE_SECONDS=20
TTL_SECONDS=30
COLD_ENTRY_CAP_TOKENS=131072
INFLIGHT_CAP=64
BLOCK_SIZE_TOKENS=64
CAPACITY_LIVENESS_SECONDS=120
INFLIGHT_REAP_SECONDS=3700

CORE_SIZING=index
CORE_ENTRY_ORDER=newcomer-first
CORE_ENGINE_CHOICE=most-free-budget
CORE_ROTATION=quantum
CORE_VICTIM=valve
CORE_SAFETY=none

BRANCH_PLUGIN=1
# YAML bool, VERBATIM into the plugin block: logRequests is a Go bool and the decode
# is strict, so `1` renders `logRequests: 1` (a number) and CrashLoops every arm.
BRANCH_LOG_REQUESTS=true
AFFINITY_FILTER=0
CORE_DETECTOR=group
BENCH_IMAGE=quay.io/dasari_surya_sai_venkatesh1/llm-d-benchmark:aiperf-rootid
