# exp-ops/configs/core-q4-offload-tierinclusive-execbudget.env — GSCH-CORE, Q=4, CPU
# OFFLOAD ON, DEFAULT queue (newcomer-first), the TIER-INCLUSIVE seat budget
# (`sizing: tier-inclusive`) AND the EXECUTION BUDGET (`executionBudget: execution-budget`).
# PREREG-multipod-offload, "THE TWO BUDGETS".
#
# THIS FILE IS core-q4-offload-tierinclusive.env WITH ONE SETTING CHANGED — the dispatch
# selector. The two are a same-build, same-digest, same-deployment pair, so any difference
# between the arms IS the execution budget:
#
#     diff docs/gsch-core/core-q4-offload-tierinclusive.env \
#          docs/gsch-core/core-q4-offload-tierinclusive-execbudget.env
#
# THE PROBLEM IT FIXES (measured, batch 2 at c64: the tier-sized arm then vs the same-digest
# q4-offload): the tier-sized budget widened the WORKING SET and then let that many members
# be SEATED — and seated members RUN. A running request's KV needs HBM blocks, so the tier
# does not widen execution: with 121,185 blocks of seats on a 40,183-block GPU (the ADDITIVE
# rule batch 2 ran — 3.02x the GPU pool, ~46 % of it blocks that live in GPU and tier at
# once), vLLM queued and preempted what the EPP had just dispatched. Measured: 43
# preemptions vs 0, TTFT p50 0.9 s -> 17.8 s, newcomer TTFT p90 9.9 s -> 142 s, while
# throughput did improve (+10.8 %) — the recompute waste is the preemption. The
# tier-inclusive correction cuts the seats to what the deployment really has — 83,011 blocks,
# 2.17x the GPU-only 38,173 — which is what this pair now runs.
#
# THE FIX = TWO BUDGETS, both from deployment facts, no constant:
#
#     SEATING  (residency) = fraction x max(num_gpu_blocks, tierBlocks)   [§4f, unchanged]
#     DISPATCH (execution) = fraction x  num_gpu_blocks                   [this arm]
#
# The dispatch budget is tested against the engine's RUNNING SET: the dedup-exact union of
# its in-flight requests' chain blocks, from the EPP's OWN accounting (the BlockIndex
# refcount of the dispatched requests — not an endpoint metric, so the deleted per-engine
# gate's latch class cannot come back). A turn that would not fit waits in the EPP's
# ordered queue (FIFO by turn arrival among the dispatch-eligible) instead of being
# dispatched into vLLM's preempting one. LIVENESS: one turn is always allowed when nothing
# is in flight on the engine.
#
# WHAT DOES NOT MOVE: the per-head cost, the cold-entry valve's cap, the queue order,
# placement, rotation. The default value is "none", and every other arm is byte-identical
# with and without this module (`TestExecutionBudgetDefaultIsGoldenNeutral`,
# `TestExecutionBudgetNoEffectWhenTheRunningSetFits`).
#
# THE IMAGE PIN: groupsched-e78152da (README §4a6) — the TIER-INCLUSIVE build, cut from
# dsai/gsch-core HEAD e78152da. This file and core-q4-offload-tierinclusive.env carry the
# SAME triple and are never re-pointed separately (ONE digest per pair).
#
#   index    sha256:4c44cf26d51017a49fae1376f3bc24fad4db268c9d51d5cc7e419cb81c27f639
#   amd64    sha256:8362525787f987f3ebd5b3927953c4751b319f2c4571daa7a4a697eecafbdc5a
#   attest   sha256:d57c5fa4e825f3035c6027abd1d33b7315c8cb26c0a2b4342aa39ec50de10850

EPP_IMAGE_TAG=groupsched-e78152da
EPP_IMAGE_DIGEST=sha256:4c44cf26d51017a49fae1376f3bc24fad4db268c9d51d5cc7e419cb81c27f639
EPP_IMAGE_DIGEST_AMD64=sha256:8362525787f987f3ebd5b3927953c4751b319f2c4571daa7a4a697eecafbdc5a
REQUIRE_BUILD_PIN=1
CHAIN=groupsched-core
PROTOCOL_CELL=weka-c64
CONCURRENCY=64

# ---- the engine's CPU KV tier (the offload deployment) ----
OFFLOAD=1
DECODE_TIER_BYTES=549755813888

# ---- the core's parameters (base block: the same for every core arm) ----
GROUP_BUDGET_FRACTION=0.95
CORE_QUANTUM=4
IDLE_SECONDS=20
TTL_SECONDS=30
INFLIGHT_CAP=64
BLOCK_SIZE_TOKENS=64
CAPACITY_LIVENESS_SECONDS=120
INFLIGHT_REAP_SECONDS=3700
CPU_TIER_BYTES=549755813888
KV_BLOCK_BYTES=6291456

# ---- the module selectors (one value each; ONE differs from core-q4-offload-tierinclusive.env) ----
CORE_SIZING=tier-inclusive
CORE_ENTRY_ORDER=newcomer-first
CORE_ENGINE_CHOICE=most-free-budget
CORE_ROTATION=quantum
CORE_VICTIM=valve
CORE_SAFETY=none
CORE_EXECUTION_BUDGET=execution-budget

# ---- the chain (see the audit) ----
BRANCH_PLUGIN=1
BRANCH_LOG_REQUESTS=true
AFFINITY_FILTER=0
CORE_DETECTOR=group
BENCH_IMAGE=quay.io/dasari_surya_sai_venkatesh1/llm-d-benchmark:aiperf-rootid
